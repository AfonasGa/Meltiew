,10.7]},"Color":{"$c3":"#2b2c33"},"Material":"Metal"}},{"c":"Part","n":"Lamp","p":{"Size":{"$v3":[0.9,0.35,0.9]},"Position":{"$v3":[-26,7.55,11.4]},"Color":{"$c3":"#ffcf8a"},"Material":"Neon","CanCollide":false,"CastShadow":false},"k":[{"c":"PointLight","n":"PointLight","p":{"Color":{"$c3":"#ffcf8a"},"Brightness":1.2,"Range":20}}]},{"c":"Part","n":"Pole","p":{"Size":{"$v3":[0.35,8,0.35]},"Position":{"$v3":[26,4.0,12]},"Color":{"$c3":"#2b2c33"},"Material":"Metal","Shape":"Cylinder"}},{"c":"Part","n":"Arm","p":{"Size":{"$v3":[0.25,0.25,1.6]},"Position":{"$v3":[26,7.8,12.7]},"Color":{"$c3":"#2b2c33"},"Material":"Metal"}},{"c":"Part","n":"Lamp","p":{"Size":{"$v3":[0.9,0.35,0.9]},"Position":{"$v3":[26,7.55,13.4]},"Color":{"$c3":"#ffcf8a"},"Material":"Neon","CanCollide":false,"CastShadow":false},"k":[{"c":"PointLight","n":"PointLight","p":{"Color":{"$c3":"#ffcf8a"},"Brightness":1.2,"Range":20}}]},{"c":"Part","n":"Pole","p":{"Size":{"$v3":[0.35,8,0.35]},"Position":{"$v3":[-22,4.0,-8]},"Color":{"$c3":"#2b2c33"},"Material":"Metal","Shape":"Cylinder"}},{"c":"Part","n":"Arm","p":{"Size":{"$v3":[0.25,0.25,1.6]},"Position":{"$v3":[-22,7.8,-7.3]},"Color":{"$c3":"#2b2c33"},"Material":"Metal"}},{"c":"Part","n":"Lamp","p":{"Size":{"$v3":[0.9,0.35,0.9]},"Position":{"$v3":[-22,7.55,-6.6]},"Color":{"$c3":"#ffcf8a"},"Material":"Neon","CanCollide":false,"CastShadow":false},"k":[{"c":"PointLight","n":"PointLight","p":{"Color":{"$c3":"#ffcf8a"},"Brightness":1.2,"Range":20}}]}]}]},{"c":"Lighting","n":"Lighting","p":{"ClockTime":19.2,"Brightness":0.75,"Ambient":{"$c3":"#5a4a6e"},"SkyTop":{"$c3":"#2a2f6b"},"SkyHorizon":{"$c3":"#f29a7a"},"FogEnabled":true,"FogColor":{"$c3":"#3b2f4f"},"FogEnd":260,"Shadows":true},"k":[{"c":"Sky","n":"Sky","p":{"Preset":"Sunset","StarsVisible":true}}]},{"c":"ReplicatedStorage","n":"ReplicatedStorage","k":[{"c":"ModuleScript","n":"Shared","p":{"Source":"-- ReplicatedStorage.Shared: the rules and numbers both sides agree on.\nlocal Shared = {}\n\nShared.MIN_PLAYERS = 2\nShared.COUNTDOWN = 20 -- seconds in the lobby once enough players are here\nShared.ROUND_TIME = 180 -- seconds survivors must last\nShared.GEN_STEPS = 3 -- puzzles to finish one generator\nShared.GEN_BONUS = 25 -- seconds a finished generator takes off the clock\nShared.KILLER_DELAY = 8 -- survivors' head start\nShared.RESULTS_TIME = 8\nShared.REPAIR_RANGE = 8 -- how close to a generator you have to stand\n\n-- Movement: the killer is quicker on a sprint and runs much longer.\nShared.LOBBY_STATS = { WalkSpeed = 5, SprintSpeed = 7, MaxStamina = 100, StaminaDrain = 20, StaminaRegen = 15, AutoHeal = true, MaxHealth = 100 }\nShared.SURVIVOR_STATS = { WalkSpeed = 5, SprintSpeed = 7.4, MaxStamina = 100, StaminaDrain = 22, StaminaRegen = 14, AutoHeal = false, MaxHealth = 100 }\nShared.KILLER_STATS = { WalkSpeed = 5.4, SprintSpeed = 8.4, MaxStamina = 220, StaminaDrain = 18, StaminaRegen = 24, AutoHeal = true, MaxHealth = 100000 }\n\n-- The killer's moves.\nShared.PUNCH = { damage = 34, range = 7, cooldown = 1.1 }\nShared.SPIKE = { damage = 26, speed = 55, range = 95, cooldown = 6 }\n\n-- Coins.\nShared.REWARD = { survive = 30, escapeDead = 8, genStep = 3, killerWin = 40, perKill = 10 }\n\n-- Maps: how the night looks on each (the lobby has its own warm evening).\nShared.MAPS = {\n\tCamp = { title = \"map_camp\", fog = \"#0b1119\", fogEnd = 82, ambient = \"#3a415e\", sky = \"#070a14\", horizon = \"#18203a\", brightness = 0.4 },\n\tFactory = { title = \"map_factory\", fog = \"#0d100f\", fogEnd = 95, ambient = \"#3a403d\", sky = \"#060807\", horizon = \"#1a221e\", brightness = 0.36 },\n}\n\n-- The characters, one of each for now. `image` is the name of a StringValue in\n-- ReplicatedStorage.Assets holding its picture's asset://id (4:3).\nShared.CHARACTERS = {\n\tkillers = {\n\t\t{ id = \"nrz\", name = \"nrz\", image = \"RenderKiller\", color = \"#ff4d6d\", desc = \"char_nrz_desc\",\n\t\t\tabilities = { \"ab_sprint\", \"ab_punch\", \"ab_spike\" } },\n\t},\n\tsurvivors = {\n\t\t{ id = \"melly\", name = \"Melly\", image = \"RenderSurvivor\", color = \"#7ee0c3\", desc = \"char_melly_desc\",\n\t\t\tabilities = { \"ab_repair\", \"ab_stamina\" } },\n\t},\n}\n\n-- The asset://id stored in ReplicatedStorage.Assets[name], or \"\" if it isn't set.\nfunction Shared.asset(name)\n\tlocal folder = game.ReplicatedStorage:FindFirstChild(\"Assets\")\n\tlocal v = folder and folder:FindFirstChild(name)\n\treturn v and v.Value or \"\"\nend\n\n-- Built-in sounds to use until the place's own are uploaded.\nlocal FALLBACK = {\n\tSfxGenDone = \"win\", SfxGenFail = \"boing\", SfxPunch = \"hurt\", SfxSpikeThrow = \"whoosh\", SfxSpikeHit = \"hurt\",\n\tSfxRoundStart = \"whoosh\", SfxSurvivorsWin = \"win\", SfxKillerWin = \"hurt\", SfxTick = \"click\",\n}\n\n-- A sound to play: the uploaded one, or a built-in stand-in (\"\" for music).\nfunction Shared.sound(name)\n\tlocal id = Shared.asset(name)\n\tif id ~= \"\" then\n\t\treturn id\n\tend\n\treturn FALLBACK[name] or \"\"\nend\n\n-- Seconds -> \"2:05\".\nfunction Shared.clock(s)\n\ts = math.max(0, math.floor(s))\n\treturn string.format(\"%d:%02d\", math.floor(s / 60), s % 60)\nend\n\nreturn Shared\n"}},{"c":"Folder","n":"Assets","k":[{"c":"StringValue","n":"MusicLobby","p":{"Value":"asset://b2d1d105d10e9144"}},{"c":"StringValue","n":"MusicCalm","p":{"Value":"asset://ea86efe6c048dc8f"}},{"c":"StringValue","n":"MusicChase","p":{"Value":"asset://c8ee0a083c2b8bf4"}},{"c":"StringValue","n":"SfxGenDone","p":{"Value":"asset://97cbe1fafc365b95"}},{"c":"StringValue","n":"SfxGenFail","p":{"Value":"asset://112205c8ca43162b"}},{"c":"StringValue","n":"SfxPunch","p":{"Value":"asset://eb02f140743aad69"}},{"c":"StringValue","n":"SfxSpikeThrow","p":{"Value":"asset://c83047b41d2baae8"}},{"c":"StringValue","n":"SfxSpikeHit","p":{"Value":"asset://8396af2448375b07"}},{"c":"StringValue","n":"SfxRoundStart","p":{"Value":"asset://e3475f448a7ceb9b"}},{"c":"StringValue","n":"SfxSurvivorsWin","p":{"Value":"asset://8253930d3819334b"}},{"c":"StringValue","n":"SfxKillerWin","p":{"Value":"asset://d17abcc172a6bfa7"}},{"c":"StringValue","n":"SfxTick","p":{"Value":""}},{"c":"StringValue","n":"RenderKiller","p":{"Value":"asset://ebfeb74d70b24840"}},{"c":"StringValue","n":"RenderSurvivor","p":{"Value":"asset://ca1c8c01dfc902ad"}}]},{"c":"Folder","n":"State","k":[{"c":"StringValue","n":"Phase","p":{"Value":"Lobby"}},{"c":"NumberValue","n":"Countdown","p":{"Value":-1}},{"c":"NumberValue","n":"Waiting","p":{"Value":0}},{"c":"StringValue","n":"Map","p":{"Value":""}},{"c":"NumberValue","n":"KillerId","p":{"Value":0}},{"c":"NumberValue","n":"GensDone","p":{"Value":0}},{"c":"NumberValue","n":"GensTotal","p":{"Value":5}},{"c":"NumberValue","n":"TimeLeft","p":{"Value":0}},{"c":"NumberValue","n":"Release","p":{"Value":0}},{"c":"NumberValue","n":"Alive","p":{"Value":0}}]},{"c":"Folder","n":"Remotes","k":[{"c":"RemoteEvent","n":"Action"},{"c":"RemoteEvent","n":"GenStart"},{"c":"RemoteEvent","n":"GenSolve"},{"c":"RemoteEvent","n":"GenFail"},{"c":"RemoteEvent","n":"Notify"},{"c":"RemoteEvent","n":"Sfx"},{"c":"RemoteEvent","n":"Result"},{"c":"RemoteEvent","n":"Hit"}]}]},{"c":"ServerScriptService","n":"ServerScriptService","k":[{"c":"Script","n":"Game","p":{"Source":"-- ServerScriptService.Game: lobby, rounds, roles, generators, the killer's moves, coins.\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal RS = game.ReplicatedStorage\nlocal SS = game.ServerStorage\nlocal Shared = require(RS.Shared)\n\nlocal State = RS.State\nlocal Remotes = RS.Remotes\nlocal Coins = game:GetService(\"DataStoreService\"):GetDataStore(\"MeltopiaCoins\")\n\n-- ------------------------------------------------------------------------------------\n-- Looks: nrz (fetched live, so the killer always wears what nrz wears) and plain Melly.\n-- ------------------------------------------------------------------------------------\n\nlocal killerLook = SS.Looks.Killer\nlocal survivorLook = SS.Looks.Survivor\n\nlocal function dressRig(rig, look)\n\tfor _, key in { \"HeadColor\", \"TorsoColor\", \"LeftArmColor\", \"RightArmColor\", \"LeftLegColor\", \"RightLegColor\", \"Face\", \"Accessories\" } do\n\t\trig[key] = look[key]\n\tend\nend\n\ntask.spawn(function()\n\tlocal ok, look = pcall(function()\n\t\treturn Players:GetUserAppearanceAsync(\"nrz\")\n\tend)\n\tif ok and look then\n\t\tlook.Parent = SS.Looks\n\t\tkillerLook = look\n\telse\n\t\twarn(\"nrz's look didn't load, using the saved one: \" .. tostring(look))\n\tend\n\tlocal lobby = workspace:FindFirstChild(\"Lobby\")\n\tif lobby and lobby:FindFirstChild(\"KillerRig\") then\n\t\tdressRig(lobby.KillerRig, killerLook)\n\tend\nend)\n\n-- ------------------------------------------------------------------------------------\n-- Players: role, coins, stats\n-- ------------------------------------------------------------------------------------\n\nlocal round = nil -- the running round, or nil\nlocal lastKiller = nil\n\nlocal function value(parent, class, name, initial)\n\tlocal v = parent:FindFirstChild(name)\n\tif not v then\n\t\tv = Instance.new(class)\n\t\tv.Name = name\n\t\tv.Value = initial\n\t\tv.Parent = parent\n\tend\n\treturn v\nend\n\nlocal function humanoidOf(player)\n\tlocal ch = player.Character\n\treturn ch and ch:FindFirstChildOfClass(\"Humanoid\")\nend\n\nlocal function rootOf(player)\n\tlocal ch = player.Character\n\treturn ch and ch:FindFirstChild(\"HumanoidRootPart\")\nend\n\nlocal function applyStats(player, stats)\n\tlocal hum = humanoidOf(player)\n\tif not hum then\n\t\treturn\n\tend\n\tfor k, v in stats do\n\t\thum[k] = v\n\tend\n\thum.Health = stats.MaxHealth\n\thum.CanJump = true\nend\n\nlocal function roleOf(player)\n\tlocal r = player:FindFirstChild(\"Role\")\n\treturn r and r.Value or \"lobby\"\nend\n\nlocal function setRole(player, role)\n\tvalue(player, \"StringValue\", \"Role\", \"lobby\").Value = role\nend\n\nlocal function addCoins(player, amount)\n\tif amount <= 0 then\n\t\treturn\n\tend\n\tlocal v = value(player, \"NumberValue\", \"Coins\", 0)\n\tv.Value += amount\n\ttask.spawn(function()\n\t\tpcall(function()\n\t\t\tv.Value = Coins:IncrementAsync(\"u\" .. player.UserId, amount)\n\t\tend)\n\tend)\nend\n\nlocal function notifyAll(key, ...)\n\tRemotes.Notify:FireAllClients(key, ...)\nend\n\nlocal function lobbySpawn()\n\tlocal spawn = workspace.Lobby.Spawn\n\tlocal a = math.random() * math.pi * 2\n\treturn spawn.Position + Vector3.new(math.cos(a) * 5, 3, math.sin(a) * 5)\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tsetRole(player, \"lobby\")\n\tvalue(player, \"NumberValue\", \"Coins\", 0)\n\tvalue(player, \"NumberValue\", \"Kills\", 0)\n\ttask.spawn(function()\n\t\tlocal ok, saved = pcall(function()\n\t\t\treturn Coins:GetAsync(\"u\" .. player.UserId)\n\t\tend)\n\t\tif ok and type(saved) == \"number\" then\n\t\t\tplayer.Coins.Value = saved\n\t\tend\n\tend)\n\tplayer.CharacterAdded:Connect(function()\n\t\ttask.wait(0.1)\n\t\tlocal role = roleOf(player)\n\t\tif role == \"killer\" then\n\t\t\tapplyStats(player, Shared.KILLER_STATS)\n\t\t\tif round and round.killer == player and not round.over then\n\t\t\t\tif player.Character and not player.Character:FindFirstChild(\"Censor\") then\n\t\t\t\t\tSS.Censor:Clone().Parent = player.Character\n\t\t\t\tend\n\t\t\t\tplayer:Teleport(round.map.Spawns.Killer.Position + Vector3.new(0, 3, 0))\n\t\t\tend\n\t\telseif role == \"survivor\" then\n\t\t\tapplyStats(player, Shared.SURVIVOR_STATS)\n\t\telse\n\t\t\t-- Back in the lobby (after being caught, or between rounds): your own look.\n\t\t\tplayer:ResetAppearance()\n\t\t\tapplyStats(player, Shared.LOBBY_STATS)\n\t\tend\n\tend)\nend)\n\n-- ------------------------------------------------------------------------------------\n-- Generators\n-- ------------------------------------------------------------------------------------\n\nlocal GEN_OFF = Color3.fromHex(\"#3a1f24\")\nlocal GEN_ON = Color3.fromHex(\"#6bffa8\")\nlocal GEN_WORK = Color3.fromHex(\"#ffcf5a\")\n\nlocal function genBase(gen)\n\treturn gen:FindFirstChild(\"Base\")\nend\n\nlocal function paintGen(gen, progress)\n\tfor i = 1, Shared.GEN_STEPS do\n\t\tlocal bulb = gen:FindFirstChild(\"Bulb\" .. i)\n\t\tif bulb then\n\t\t\tbulb.Color = i <= progress and GEN_ON or GEN_OFF\n\t\tend\n\tend\n\tlocal lamp = gen:FindFirstChild(\"Lamp\")\n\tif lamp then\n\t\tlocal light = lamp:FindFirstChildOfClass(\"PointLight\")\n\t\tlocal done = progress >= Shared.GEN_STEPS\n\t\tlamp.Color = done and GEN_ON or (progress > 0 and GEN_WORK or Color3.fromHex(\"#ff3b4f\"))\n\t\tif light then\n\t\t\tlight.Color = lamp.Color\n\t\t\tlight.Brightness = done and 3 or 1.2\n\t\t\tlight.Range = done and 22 or 9\n\t\tend\n\tend\nend\n\nlocal function playAt(part, soundName, volume)\n\tlocal id = Shared.sound(soundName)\n\tif id == \"\" or not part then\n\t\treturn\n\tend\n\tlocal s = Instance.new(\"Sound\")\n\ts.SoundId = id\n\ts.Volume = volume or 1\n\ts.Parent = part\n\ts:Play()\n\tgame:GetService(\"Debris\"):AddItem(s, 6)\nend\n\nlocal function playForAll(soundName)\n\tRemotes.Sfx:FireAllClients(soundName)\nend\n\n-- ------------------------------------------------------------------------------------\n-- Rounds\n-- ------------------------------------------------------------------------------------\n\nlocal function participants()\n\tif not round then\n\t\treturn {}\n\tend\n\tlocal out = {}\n\tfor p in round.alive do\n\t\tif p.Parent then\n\t\t\ttable.insert(out, p)\n\t\tend\n\tend\n\treturn out\nend\n\nlocal function survivorsAlive()\n\tif not round then\n\t\treturn 0\n\tend\n\tlocal n = 0\n\tfor p in round.alive do\n\t\tif p ~= round.killer and p.Parent then\n\t\t\tn += 1\n\t\tend\n\tend\n\treturn n\nend\n\nlocal function endRound(winner)\n\tif not round or round.over then\n\t\treturn\n\tend\n\tround.over = true\n\tround.winner = winner\nend\n\nlocal function onSurvivorDown(player, byKiller)\n\tif not round or not round.alive[player] or player == round.killer then\n\t\treturn\n\tend\n\tround.alive[player] = nil\n\tsetRole(player, \"dead\")\n\tif byKiller and round.killer and round.killer.Parent then\n\t\tround.kills += 1\n\t\tround.killer.Kills.Value += 1\n\tend\n\tnotifyAll(\"n_caught\", player.DisplayName)\n\tState.Alive.Value = survivorsAlive()\n\tif survivorsAlive() == 0 then\n\t\tendRound(\"killer\")\n\tend\nend\n\nlocal function hookHumanoid(player)\n\tlocal hum = humanoidOf(player)\n\tif not hum then\n\t\treturn\n\tend\n\thum.Died:Connect(function()\n\t\tif round and round.alive[player] and player ~= round.killer then\n\t\t\tlocal hit = round.hitAt[player]\n\t\t\tonSurvivorDown(player, hit ~= nil and time() - hit < 10)\n\t\tend\n\tend)\nend\n\nlocal function pickKiller(list)\n\tlocal pool = {}\n\tfor _, p in list do\n\t\tif p ~= lastKiller or #list <= 1 then\n\t\t\ttable.insert(pool, p)\n\t\tend\n\tend\n\tif #pool == 0 then\n\t\tpool = list\n\tend\n\treturn pool[math.random(1, #pool)]\nend\n\nlocal function shuffle(t)\n\tfor i = #t, 2, -1 do\n\t\tlocal j = math.random(1, i)\n\t\tt[i], t[j] = t[j], t[i]\n\tend\n\treturn t\nend\n\nlocal function runRound(players)\n\tlocal maps = SS.Maps:GetChildren()\n\tlocal template = maps[math.random(1, #maps)]\n\tlocal map = template:Clone()\n\tmap.Parent = workspace\n\n\tlocal killer = pickKiller(players)\n\tlastKiller = killer\n\tround = { map = map, killer = killer, alive = {}, kills = 0, gens = {}, puzzles = {}, steps = {}, over = false,\n\t\tcooldowns = { punch = 0, spike = 0 }, released = false, timeLeft = Shared.ROUND_TIME, hitAt = {} }\n\n\tlocal gens = map.Generators:GetChildren()\n\tfor _, gen in gens do\n\t\tround.gens[gen] = 0\n\t\tpaintGen(gen, 0)\n\tend\n\n\tState.Map.Value = map.Name\n\tState.KillerId.Value = killer.UserId\n\tState.GensDone.Value = 0\n\tState.GensTotal.Value = #gens\n\tState.TimeLeft.Value = Shared.ROUND_TIME\n\tState.Release.Value = Shared.KILLER_DELAY\n\tState.Phase.Value = \"Round\"\n\n\t-- Roles, looks, places.\n\tlocal spawns = {}\n\tfor _, s in map.Spawns:GetChildren() do\n\t\tif s.Name == \"Survivor\" then\n\t\t\ttable.insert(spawns, s.Position)\n\t\tend\n\tend\n\tshuffle(spawns)\n\tfor i, p in players do\n\t\tround.alive[p] = true\n\t\tp.Kills.Value = 0\n\t\tif p == killer then\n\t\t\tsetRole(p, \"killer\")\n\t\t\tp:ApplyAppearance(killerLook)\n\t\t\t-- No face, just a black square that always looks at you.\n\t\t\tif p.Character and not p.Character:FindFirstChild(\"Censor\") then\n\t\t\t\tSS.Censor:Clone().Parent = p.Character\n\t\t\tend\n\t\t\tapplyStats(p, Shared.KILLER_STATS)\n\t\t\tlocal hum = humanoidOf(p)\n\t\t\tif hum then\n\t\t\t\thum.WalkSpeed = 0\n\t\t\t\thum.SprintSpeed = 0\n\t\t\t\thum.CanJump = false\n\t\t\tend\n\t\t\tp:Teleport(map.Spawns.Killer.Position + Vector3.new(0, 3, 0))\n\t\telse\n\t\t\tsetRole(p, \"survivor\")\n\t\t\tp:ApplyAppearance(survivorLook)\n\t\t\tapplyStats(p, Shared.SURVIVOR_STATS)\n\t\t\tlocal at = spawns[((i - 1) % #spawns) + 1]\n\t\t\tp:Teleport(at + Vector3.new(math.random(-2, 2), 3, math.random(-2, 2)))\n\t\tend\n\t\thookHumanoid(p)\n\tend\n\tState.Alive.Value = survivorsAlive()\n\tplayForAll(\"SfxRoundStart\")\n\n\t-- The killer waits while the survivors scatter.\n\tfor s = Shared.KILLER_DELAY, 1, -1 do\n\t\tState.Release.Value = s\n\t\ttask.wait(1)\n\t\tif round.over then\n\t\t\tbreak\n\t\tend\n\tend\n\tState.Release.Value = 0\n\tround.released = true\n\tif killer.Parent then\n\t\tapplyStats(killer, Shared.KILLER_STATS)\n\tend\n\tnotifyAll(\"n_released\")\n\n\t-- The clock.\n\twhile not round.over do\n\t\ttask.wait(1)\n\t\tround.timeLeft -= 1\n\t\tState.TimeLeft.Value = math.max(0, round.timeLeft)\n\t\tif not killer.Parent then\n\t\t\tendRound(\"survivors\")\n\t\telseif survivorsAlive() == 0 then\n\t\t\tendRound(\"killer\")\n\t\telseif round.timeLeft <= 0 then\n\t\t\tendRound(\"survivors\")\n\t\tend\n\tend\n\n\t-- Results and coins.\n\tState.Phase.Value = \"End\"\n\tlocal winner = round.winner\n\tfor p in pairs(round.steps) do\n\t\tif p.Parent then\n\t\t\taddCoins(p, round.steps[p] * Shared.REWARD.genStep)\n\t\tend\n\tend\n\tfor _, p in players do\n\t\tif p.Parent then\n\t\t\tlocal earned = 0\n\t\t\tif p == killer then\n\t\t\t\tearned = round.kills * Shared.REWARD.perKill + (winner == \"killer\" and Shared.REWARD.killerWin or 0)\n\t\t\telseif winner == \"survivors\" then\n\t\t\t\tearned = round.alive[p] and Shared.REWARD.survive or Shared.REWARD.escapeDead\n\t\t\tend\n\t\t\taddCoins(p, earned)\n\t\t\tlocal won = (p == killer) == (winner == \"killer\")\n\t\t\tRemotes.Result:FireClient(p, winner, won, earned + (round.steps[p] or 0) * Shared.REWARD.genStep, round.kills)\n\t\tend\n\tend\n\tplayForAll(winner == \"killer\" and \"SfxKillerWin\" or \"SfxSurvivorsWin\")\n\ttask.wait(Shared.RESULTS_TIME)\n\n\t-- Everyone home.\n\tfor _, p in players do\n\t\tif p.Parent then\n\t\t\tsetRole(p, \"lobby\")\n\t\t\tp:ResetAppearance()\n\t\t\tlocal censor = p.Character and p.Character:FindFirstChild(\"Censor\")\n\t\t\tif censor then\n\t\t\t\tcensor:Destroy()\n\t\t\tend\n\t\t\tapplyStats(p, Shared.LOBBY_STATS)\n\t\t\tlocal hum = humanoidOf(p)\n\t\t\tif hum and hum.Health > 0 then\n\t\t\t\tp:Teleport(lobbySpawn())\n\t\t\tend\n\t\tend\n\tend\n\tfor _, s in workspace:GetChildren() do\n\t\tif s.Name == \"Spike\" then\n\t\t\ts:Destroy()\n\t\tend\n\tend\n\tmap:Destroy()\n\tround = nil\n\tState.Map.Value = \"\"\n\tState.KillerId.Value = 0\n\tState.Phase.Value = \"Lobby\"\nend\n\n-- The lobby loop: wait for players, count down, play.\ntask.spawn(function()\n\tState.Phase.Value = \"Lobby\"\n\twhile true do\n\t\tlocal ready = Players:GetPlayers()\n\t\tif #ready < Shared.MIN_PLAYERS then\n\t\t\tState.Countdown.Value = -1\n\t\t\tState.Waiting.Value = #ready\n\t\t\ttask.wait(1)\n\t\telse\n\t\t\tlocal ok = true\n\t\t\tfor s = Shared.COUNTDOWN, 1, -1 do\n\t\t\t\tState.Countdown.Value = s\n\t\t\t\tState.Waiting.Value = #Players:GetPlayers()\n\t\t\t\tif #Players:GetPlayers() < Shared.MIN_PLAYERS then\n\t\t\t\t\tok = false\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\t\ttask.wait(1)\n\t\t\tend\n\t\t\tState.Countdown.Value = -1\n\t\t\tif ok then\n\t\t\t\tlocal list = {}\n\t\t\t\tfor _, p in Players:GetPlayers() do\n\t\t\t\t\tif humanoidOf(p) and humanoidOf(p).Health > 0 then\n\t\t\t\t\t\ttable.insert(list, p)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tif #list >= Shared.MIN_PLAYERS then\n\t\t\t\t\tlocal okRun, err = pcall(runRound, list)\n\t\t\t\t\tif not okRun then\n\t\t\t\t\t\twarn(\"round failed: \" .. tostring(err))\n\t\t\t\t\t\tif round and round.map then\n\t\t\t\t\t\t\tround.map:Destroy()\n\t\t\t\t\t\tend\n\t\t\t\t\t\tround = nil\n\t\t\t\t\t\tState.Phase.Value = \"Lobby\"\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tif round and round.alive[player] then\n\t\tif player == round.killer then\n\t\t\tendRound(\"survivors\")\n\t\telse\n\t\t\tonSurvivorDown(player, false)\n\t\tend\n\tend\nend)\n\n-- ------------------------------------------------------------------------------------\n-- Generators: a survivor opens a puzzle, solves it, the generator moves on.\n-- ------------------------------------------------------------------------------------\n\nlocal function nearGen(player, gen)\n\tlocal root = rootOf(player)\n\tlocal base = gen and gen.Parent and genBase(gen)\n\t-- A little more room than the button needs: where the server last heard you were lags behind.\n\treturn root and base and (root.Position - base.Position).Magnitude <= Shared.REPAIR_RANGE + 5\nend\n\nlocal function canRepair(player, gen)\n\treturn round and not round.over and round.alive[player] and player ~= round.killer\n\t\tand typeof(gen) == \"Instance\" and round.gens[gen] ~= nil and round.gens[gen] < Shared.GEN_STEPS\n\t\tand nearGen(player, gen)\nend\n\nRemotes.GenStart.OnServerEvent:Connect(function(player, gen)\n\tif canRepair(player, gen) then\n\t\tround.puzzles[player] = { gen = gen, at = time() }\n\tend\nend)\n\nRemotes.GenSolve.OnServerEvent:Connect(function(player, gen)\n\tlocal p = round and round.puzzles[player]\n\t-- The app waits about 2 s before sending; a solve faster than 1 s wasn't done by hand.\n\tif not p or p.gen ~= gen or time() - p.at < 1 or not canRepair(player, gen) then\n\t\treturn\n\tend\n\tround.puzzles[player] = nil\n\tround.gens[gen] += 1\n\tround.steps[player] = (round.steps[player] or 0) + 1\n\tlocal progress = round.gens[gen]\n\tpaintGen(gen, progress)\n\tif progress >= Shared.GEN_STEPS then\n\t\tround.timeLeft = math.max(1, round.timeLeft - Shared.GEN_BONUS)\n\t\tState.TimeLeft.Value = round.timeLeft\n\t\tState.GensDone.Value += 1\n\t\tplayAt(genBase(gen), \"SfxGenDone\", 1.2)\n\t\tnotifyAll(\"n_gen_done\", Shared.GEN_BONUS)\n\telse\n\t\tplayAt(genBase(gen), \"SfxTick\", 0.8)\n\tend\nend)\n\n-- A mistake makes a racket the killer hears, and points them to it.\nRemotes.GenFail.OnServerEvent:Connect(function(player, gen)\n\tif not canRepair(player, gen) then\n\t\treturn\n\tend\n\tlocal now = time()\n\tif round.lastNoise and now - round.lastNoise < 2 then\n\t\treturn\n\tend\n\tround.lastNoise = now\n\tround.puzzles[player] = nil\n\tplayAt(genBase(gen), \"SfxGenFail\", 1.6)\n\tif round.killer and round.killer.Parent then\n\t\tRemotes.Notify:FireClient(round.killer, \"n_noise\", genBase(gen).Position)\n\tend\nend)\n\n-- ------------------------------------------------------------------------------------\n-- The killer's moves\n-- ------------------------------------------------------------------------------------\n\nlocal function flatDir(v)\n\tif typeof(v) ~= \"Vector3\" then\n\t\treturn nil\n\tend\n\tlocal d = Vector3.new(v.X, 0, v.Z)\n\tif d.Magnitude < 0.01 then\n\t\treturn nil\n\tend\n\treturn d.Unit\nend\n\nlocal function hurt(victim, amount, sound)\n\tlocal hum = humanoidOf(victim)\n\tif not hum or hum.Health <= 0 then\n\t\treturn\n\tend\n\tround.hitAt[victim] = time()\n\thum:TakeDamage(amount)\n\tplayAt(rootOf(victim), sound, 1.3)\n\tRemotes.Hit:FireClient(victim, amount)\nend\n\nlocal function punch(killer, dir)\n\tlocal root = rootOf(killer)\n\tif not root then\n\t\treturn\n\tend\n\tlocal best, bestD = nil, math.huge\n\tfor p in round.alive do\n\t\tif p ~= killer then\n\t\t\tlocal r = rootOf(p)\n\t\t\tif r then\n\t\t\t\tlocal to = r.Position - root.Position\n\t\t\t\tlocal d = to.Magnitude\n\t\t\t\tlocal flat = Vector3.new(to.X, 0, to.Z)\n\t\t\t\tlocal facing = flat.Magnitude < 0.5 and 1 or flat.Unit:Dot(dir)\n\t\t\t\tif d <= Shared.PUNCH.range and facing > 0.3 and math.abs(to.Y) < 5 and d < bestD then\n\t\t\t\t\tbest, bestD = p, d\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif best then\n\t\thurt(best, Shared.PUNCH.damage, \"SfxPunch\")\n\tend\nend\n\nlocal spikeTemplate = SS.Spike\n\nlocal function throwSpike(killer, aim)\n\tlocal root = rootOf(killer)\n\tif not root then\n\t\treturn\n\tend\n\t-- Straight and level at chest height: the camera looks down at your character,\n\t-- and following its tilt sent spikes into the ground.\n\tlocal dir = flatDir(aim)\n\tif not dir then\n\t\treturn\n\tend\n\tlocal pos = root.Position + Vector3.new(0, 1.7, 0) + dir * 1.4\n\tlocal spike = spikeTemplate:Clone()\n\tspike.Name = \"Spike\"\n\tspike.Rotation = Vector3.new(0, math.deg(math.atan2(dir.X, dir.Z)), 0)\n\tspike.Position = pos\n\tspike.Parent = workspace\n\tplayAt(spike, \"SfxSpikeThrow\", 1.2)\n\n\tlocal ignore = { spike }\n\tfor _, p in Players:GetPlayers() do\n\t\tif p.Character then\n\t\t\ttable.insert(ignore, p.Character)\n\t\tend\n\tend\n\tlocal params = RaycastParams.new()\n\tparams.FilterDescendantsInstances = ignore\n\tparams.FilterType = \"Exclude\"\n\tparams.RespectCanCollide = true\n\n\tlocal traveled = 0\n\tlocal conn\n\tconn = RunService.Heartbeat:Connect(function(dt)\n\t\tif not spike.Parent or not round or round.over then\n\t\t\tconn:Disconnect()\n\t\t\tif spike.Parent then\n\t\t\t\tspike:Destroy()\n\t\t\tend\n\t\t\treturn\n\t\tend\n\t\tlocal step = Shared.SPIKE.speed * math.min(dt, 0.1)\n\t\tlocal from = spike.Position\n\t\tlocal to = from + dir * step\n\t\t-- Anyone along this stretch?\n\t\tfor p in round.alive do\n\t\t\tif p ~= killer then\n\t\t\t\tlocal r = rootOf(p)\n\t\t\t\tif r then\n\t\t\t\t\tlocal c = r.Position + Vector3.new(0, 1.6, 0)\n\t\t\t\t\tlocal t = math.clamp((c - from):Dot(dir) / step, 0, 1)\n\t\t\t\t\tlocal closest = from + dir * step * t\n\t\t\t\t\tif (c - closest).Magnitude < 2.1 then\n\t\t\t\t\t\tconn:Disconnect()\n\t\t\t\t\t\thurt(p, Shared.SPIKE.damage, \"SfxSpikeHit\")\n\t\t\t\t\t\tspike:Destroy()\n\t\t\t\t\t\treturn\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tlocal hit = workspace:Raycast(from, dir * step, params)\n\t\tif hit then\n\t\t\tconn:Disconnect()\n\t\t\tspike.Position = hit.Position - dir * 0.8\n\t\t\tplayAt(spike, \"SfxSpikeHit\", 0.8)\n\t\t\tgame:GetService(\"Debris\"):AddItem(spike, 3)\n\t\t\treturn\n\t\tend\n\t\tspike.Position = to\n\t\ttraveled += step\n\t\tif traveled >= Shared.SPIKE.range then\n\t\t\tconn:Disconnect()\n\t\t\tspike:Destroy()\n\t\tend\n\tend)\nend\n\nRemotes.Action.OnServerEvent:Connect(function(player, move, aim)\n\tif not round or round.over or player ~= round.killer or not round.released then\n\t\treturn\n\tend\n\tlocal dir = flatDir(aim)\n\tif not dir then\n\t\treturn\n\tend\n\tlocal now = time()\n\tif move == \"punch\" and now >= round.cooldowns.punch then\n\t\tround.cooldowns.punch = now + Shared.PUNCH.cooldown - 0.1\n\t\tpunch(player, dir)\n\telseif move == \"spike\" and now >= round.cooldowns.spike then\n\t\tround.cooldowns.spike = now + Shared.SPIKE.cooldown - 0.2\n\t\tthrowSpike(player, aim)\n\tend\nend)\n"}}]},{"c":"ServerStorage","n":"ServerStorage","k":[{"c":"Folder","n":"Maps","k":[{"c":"Model","n":"Camp","k":[{"c":"Part","n":"Ground","p":{"Size":{"$v3":[200,1,200]},"Position":{"$v3":[0,-0.5,600]},"Color":{"$c3":"#1c2a21"},"Material":"Grass"}},{"c":"Part","n":"Path","p":{"Size":{"$v3":[5,0.1,89.0]},"Position":{"$v3":[0.0,0.05,557.5]},"Color":{"$c3":"#3a2f25"},"Material":"Sand","CastShadow":false}},{"c":"Part","n":"Path","p":{"Size":{"$v3":[5,0.1,62.138]},"Position":{"$v3":[-22.0,