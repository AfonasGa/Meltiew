{"format":"melt","version":1,"meta":{"name":"Meltopia","description":"One of you is the killer, everyone else must survive the night. Fix the generators to make the night shorter, hide, run and don't get caught. Two maps, a new killer every round.","i18n":{"name":{"ru":"Meltopia"},"description":{"ru":"Один из вас убийца, остальные должны пережить ночь. Чините генераторы, чтобы ночь кончилась быстрее, прячьтесь, бегите и не попадайтесь. Две карты, каждый раунд новый убийца."}}},"strings":{"st_release":{"en":"The killer is out in {0}","ru":"Убийца выйдет через {0}"},"st_round_sub":{"en":"Generators {0}/{1}  ·  Alive {2}","ru":"Генераторы {0}/{1}  ·  Живых {2}"},"st_watching":{"en":"Round in progress  ·  Alive {0}","ru":"Идёт раунд  ·  Живых {0}"},"st_end":{"en":"Round over","ru":"Раунд окончен"},"st_starting":{"en":"Round in {0}","ru":"Раунд через {0}"},"st_players":{"en":"Players: {0}","ru":"Игроков: {0}"},"st_waiting":{"en":"Waiting for players","ru":"Ждём игроков"},"st_need":{"en":"{0} of {1} needed to start","ru":"{0} из {1}, чтобы начать"},"btn_characters":{"en":"Characters","ru":"Персонажи"},"btn_watch":{"en":"Watch the round","ru":"Смотреть раунд"},"btn_watching":{"en":"Watching: {0}","ru":"Смотрю: {0}"},"btn_stop_watch":{"en":"Back to lobby","ru":"В лобби"},"coins":{"en":"{0} coins","ru":"{0} монет"},"inv_title":{"en":"Characters","ru":"Персонажи"},"tag_killer":{"en":"KILLER","ru":"УБИЙЦА"},"tag_survivor":{"en":"SURVIVOR","ru":"ВЫЖИВШИЙ"},"equipped":{"en":"Equipped","ru":"Выбран"},"char_nrz_desc":{"en":"Quiet, fast and never tired. He built this place.","ru":"Тихий, быстрый и не устаёт. Это он построил всё вокруг."},"char_melly_desc":{"en":"Small, sharp and good with wires. Just wants to see the morning.","ru":"Маленькая, шустрая, дружит с проводами. Просто хочет дожить до утра."},"ab_sprint":{"en":"Long sprint: much more stamina","ru":"Долгий спринт: стамины куда больше"},"ab_punch":{"en":"Punch: heavy hit up close","ru":"Удар: тяжёлый, вблизи"},"ab_spike":{"en":"Spike: thrown far, flies straight","ru":"Шип: летит далеко и прямо"},"ab_repair":{"en":"Repair: solves generator puzzles","ru":"Починка: решает головоломки генераторов"},"ab_stamina":{"en":"Quick feet: a short burst of sprint","ru":"Быстрые ноги: короткий рывок"},"pz_ok":{"en":"Done!","ru":"Готово!"},"pz_fail":{"en":"Sparks! The killer heard that","ru":"Искры! Убийца это услышал"},"pz_wires":{"en":"Wires","ru":"Провода"},"pz_wires_hint":{"en":"Connect each wire to the same color","ru":"Соедини каждый провод с таким же цветом"},"pz_order":{"en":"Switches","ru":"Рубильники"},"pz_order_hint":{"en":"Press them in order, 1 to 9","ru":"Жми по порядку, от 1 до 9"},"btn_repair":{"en":"Repair  [E]  {0}/{1}","ru":"Чинить  [E]  {0}/{1}"},"btn_repair_touch":{"en":"Repair {0}/{1}","ru":"Чинить {0}/{1}"},"ab_btn_punch":{"en":"Punch","ru":"Удар"},"ab_btn_spike":{"en":"Spike","ru":"Шип"},"n_noise":{"en":"Someone messed up a generator!","ru":"Кто-то запорол генератор!"},"n_caught":{"en":"{0} was caught","ru":"{0} пойман(а)"},"n_gen_done":{"en":"Generator is on! -{0} s of night","ru":"Генератор заработал! Ночь короче на {0} с"},"n_released":{"en":"The killer is out. Run.","ru":"Убийца вышел. Беги."},"n_released_you":{"en":"Go. Find them.","ru":"Вперёд. Найди их."},"res_killer":{"en":"The killer wins","ru":"Победил убийца"},"res_survivors":{"en":"Morning came. Survivors win","ru":"Наступило утро. Выжившие победили"},"res_you_won":{"en":"You won","ru":"Ты победил"},"res_you_lost":{"en":"You lost","ru":"Ты проиграл"},"res_coins":{"en":"+{0} coins","ru":"+{0} монет"},"res_kills":{"en":"Caught: {0}","ru":"Поймано: {0}"},"role_killer":{"en":"You are the killer","ru":"Ты убийца"},"role_killer_goal":{"en":"You play {0}. Catch everyone before morning","ru":"Играешь за {0}. Поймай всех до утра"},"role_killer_touch":{"en":"Sprint for long chases · Punch up close · Throw spikes far","ru":"Спринт для погони · Удар вблизи · Шип издалека"},"role_killer_keys":{"en":"Shift sprint · LMB/F punch · E spike","ru":"Shift спринт · ЛКМ/F удар · E шип"},"role_survivor":{"en":"You are a survivor","ru":"Ты выживший"},"role_survivor_goal":{"en":"You play {0}. Last until morning","ru":"Играешь за {0}. Продержись до утра"},"role_survivor_touch":{"en":"Fix generators to make the night shorter. Hide.","ru":"Чини генераторы, чтобы ночь кончилась быстрее. Прячься."},"role_survivor_keys":{"en":"Shift sprint · E repair · fixed generators shorten the night","ru":"Shift спринт · E чинить · генераторы укорачивают ночь"},"caught_title":{"en":"Caught","ru":"Пойман"},"caught_sub":{"en":"Watch the others until the round ends","ru":"Смотри за остальными до конца раунда"},"map_camp":{"en":"Pine Lake Camp","ru":"Лагерь «Сосновое озеро»"},"map_factory":{"en":"Old Factory","ru":"Старая фабрика"},"title":{"en":"MELTOPIA","ru":"MELTOPIA"},"subtitle":{"en":"survive the night","ru":"переживи ночь"},"tag_killer_nrz":{"en":"nrz · killer","ru":"nrz · убийца"},"tag_survivor_melly":{"en":"Melly · survivor","ru":"Melly · выживший"},"how_title":{"en":"HOW TO PLAY","ru":"КАК ИГРАТЬ"},"how_1":{"en":"One of you is the killer","ru":"Один из вас убийца"},"how_2":{"en":"Survivors fix generators","ru":"Выжившие чинят генераторы"},"how_3":{"en":"Every generator shortens the night","ru":"Каждый генератор укорачивает ночь"},"how_4":{"en":"Win and earn coins","ru":"Побеждай и получай монетки"},"camp_sign":{"en":"PINE LAKE CAMP","ru":"ЛАГЕРЬ СОСНОВОЕ ОЗЕРО"},"tank_text":{"en":"MELTWORKS","ru":"МЕЛТЗАВОД"},"office_sign":{"en":"OFFICE","ru":"КОНТОРА"},"factory_sign":{"en":"OLD FACTORY · KEEP OUT","ru":"СТАРАЯ ФАБРИКА · НЕ ВХОДИТЬ"}},"tree":{"c":"DataModel","k":[{"c":"Workspace","n":"Workspace","p":{"Gravity":22,"FallHeight":-40},"k":[{"c":"Model","n":"Lobby","k":[{"c":"Part","n":"Ground","p":{"Size":{"$v3":[110,2,110]},"Position":{"$v3":[0,-1,0]},"Color":{"$c3":"#2f4a33"},"Material":"Grass","Shape":"Cylinder"}},{"c":"Part","n":"Edge","p":{"Size":{"$v3":[112,1.6,112]},"Position":{"$v3":[0,-1.6,0]},"Color":{"$c3"